# Copy to `.env` and adjust for your setup:
#   cp .env.example .env
# .env is git-ignored — never commit real credentials.

# -----------------------------------------------------------------------------
# Frontend mode (read by Vite)
# -----------------------------------------------------------------------------
# `mock` (default) — frontend uses src/api/mockApi.js + localStorage. No
#                    backend or PostgreSQL required.
# `api`            — frontend uses src/api/realApi.js, which calls
#                    /api/... on the Express backend. Requires PostgreSQL +
#                    a fully implemented server/.
VITE_DATA_MODE=mock

# -----------------------------------------------------------------------------
# Backend / PostgreSQL settings (only used in `api` mode)
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=restaurant_db
PGUSER=postgres
PGPASSWORD=

SERVER_PORT=3001
